<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="panda_srdf" params="prefix virtual_joint_type:='fixed'">
    
    <group name="${prefix}panda_arm">
      <chain base_link="${prefix}panda_link0" tip_link="${prefix}panda_link8" />
    </group>

    <group name="${prefix}hand">
      <link name="${prefix}panda_hand"/>
      <link name="${prefix}panda_leftfinger"/>
      <link name="${prefix}panda_rightfinger"/>
      <joint name="${prefix}panda_finger_joint1"/>
      <joint name="${prefix}panda_finger_joint2"/>
    </group>

    <group name="${prefix}panda_arm_hand">
      <group name="${prefix}panda_arm"/>
      <group name="${prefix}hand"/>
    </group>

    <end_effector name="${prefix}hand_eef" parent_link="${prefix}panda_link8" group="${prefix}hand" parent_group="${prefix}panda_arm"/>
    <end_effector name="${prefix}hand" parent_link="${prefix}panda_link8" group="${prefix}hand"/>

    <group_state group="${prefix}panda_arm" name="ready">
        <joint name="${prefix}panda_joint1" value="0"/>
        <joint name="${prefix}panda_joint2" value="-0.785"/>
        <joint name="${prefix}panda_joint3" value="0"/>
        <joint name="${prefix}panda_joint4" value="-2.356"/>
        <joint name="${prefix}panda_joint5" value="0"/>
        <joint name="${prefix}panda_joint6" value="1.571"/>
        <joint name="${prefix}panda_joint7" value="0.785"/>
    </group_state>

    <group_state group="${prefix}panda_arm" name="extended">
        <joint name="${prefix}panda_joint1" value="0"/>
        <joint name="${prefix}panda_joint2" value="0"/>
        <joint name="${prefix}panda_joint3" value="0"/>
        <joint name="${prefix}panda_joint4" value="0"/>
        <joint name="${prefix}panda_joint5" value="0"/>
        <joint name="${prefix}panda_joint6" value="1.571"/>
        <joint name="${prefix}panda_joint7" value="0.785"/>
    </group_state>

    <group_state group="${prefix}panda_arm" name="transport">
        <joint name="${prefix}panda_joint1" value="0"/>
        <joint name="${prefix}panda_joint2" value="-0.5599"/>
        <joint name="${prefix}panda_joint3" value="0"/>
        <joint name="${prefix}panda_joint4" value="-2.97"/>
        <joint name="${prefix}panda_joint5" value="0"/>
        <joint name="${prefix}panda_joint6" value="0"/>
        <joint name="${prefix}panda_joint7" value="0.785"/>
    </group_state>

    <group_state group="${prefix}hand" name="open">
        <joint name="${prefix}panda_finger_joint1" value="0.04"/>
        <joint name="${prefix}panda_finger_joint2" value="0.04"/>
    </group_state>
    
    <group_state group="${prefix}hand" name="closed">
        <joint name="${prefix}panda_finger_joint1" value="0.0"/>
        <joint name="${prefix}panda_finger_joint2" value="0.0"/>
    </group_state>

    <!-- Virtual joint com tipo parametrizável -->
    <virtual_joint name="${prefix}virtual_joint" type="floating" parent_frame="world" child_link="${prefix}panda_link0" />

    <disable_collisions link1="${prefix}panda_link0" link2="${prefix}panda_link1" reason="Adjacent"/>
    <disable_collisions link1="${prefix}panda_link0" link2="${prefix}panda_link2" reason="Never"/>
    <disable_collisions link1="${prefix}panda_link0" link2="${prefix}panda_link3" reason="Never"/>
    <disable_collisions link1="${prefix}panda_link0" link2="${prefix}panda_link4" reason="Never"/>
    
    <disable_collisions link1="${prefix}panda_link1" link2="${prefix}panda_link2" reason="Adjacent"/>
    <disable_collisions link1="${prefix}panda_link1" link2="${prefix}panda_link3" reason="Never"/>
    <disable_collisions link1="${prefix}panda_link1" link2="${prefix}panda_link4" reason="Never"/>
    
    <disable_collisions link1="${prefix}panda_link2" link2="${prefix}panda_link3" reason="Adjacent"/>
    <disable_collisions link1="${prefix}panda_link2" link2="${prefix}panda_link4" reason="Never"/>
    <disable_collisions link1="${prefix}panda_link2" link2="${prefix}panda_link6" reason="Never"/>
    
    <disable_collisions link1="${prefix}panda_link3" link2="${prefix}panda_link4" reason="Adjacent"/>
    <disable_collisions link1="${prefix}panda_link3" link2="${prefix}panda_link5" reason="Never"/>
    <disable_collisions link1="${prefix}panda_link3" link2="${prefix}panda_link6" reason="Never"/>
    <disable_collisions link1="${prefix}panda_link3" link2="${prefix}panda_link7" reason="Never"/>
    
    <disable_collisions link1="${prefix}panda_link4" link2="${prefix}panda_link5" reason="Adjacent"/>
    <disable_collisions link1="${prefix}panda_link4" link2="${prefix}panda_link6" reason="Never"/>
    <disable_collisions link1="${prefix}panda_link4" link2="${prefix}panda_link7" reason="Never"/>
    
    <disable_collisions link1="${prefix}panda_link5" link2="${prefix}panda_link6" reason="Adjacent"/>
    <disable_collisions link1="${prefix}panda_link6" link2="${prefix}panda_link7" reason="Adjacent"/>
    
    <disable_collisions link1="${prefix}panda_hand" link2="${prefix}panda_leftfinger" reason="Adjacent"/>
    <disable_collisions link1="${prefix}panda_hand" link2="${prefix}panda_rightfinger" reason="Adjacent"/>
    <disable_collisions link1="${prefix}panda_leftfinger" link2="${prefix}panda_rightfinger" reason="Default"/>
    
    <disable_collisions link1="${prefix}panda_hand" link2="${prefix}panda_link3" reason="Never"/>
    <disable_collisions link1="${prefix}panda_hand" link2="${prefix}panda_link4" reason="Never"/>
    <disable_collisions link1="${prefix}panda_hand" link2="${prefix}panda_link6" reason="Never"/>
    <disable_collisions link1="${prefix}panda_hand" link2="${prefix}panda_link7" reason="Adjacent"/>
    
    <disable_collisions link1="${prefix}panda_leftfinger" link2="${prefix}panda_link3" reason="Never"/>
    <disable_collisions link1="${prefix}panda_leftfinger" link2="${prefix}panda_link4" reason="Never"/>
    <disable_collisions link1="${prefix}panda_leftfinger" link2="${prefix}panda_link6" reason="Never"/>
    <disable_collisions link1="${prefix}panda_leftfinger" link2="${prefix}panda_link7" reason="Never"/>
    
    <disable_collisions link1="${prefix}panda_link3" link2="${prefix}panda_rightfinger" reason="Never"/>
    <disable_collisions link1="${prefix}panda_link4" link2="${prefix}panda_rightfinger" reason="Never"/>
    <disable_collisions link1="${prefix}panda_link6" link2="${prefix}panda_rightfinger" reason="Never"/>
    <disable_collisions link1="${prefix}panda_link7" link2="${prefix}panda_rightfinger" reason="Never"/>

    <disable_collisions link1="${prefix}panda_link5" link2="${prefix}panda_link7" reason="User"/>
    <disable_collisions link1="${prefix}panda_hand" link2="${prefix}panda_link5" reason="User"/>

  </xacro:macro>
</robot>