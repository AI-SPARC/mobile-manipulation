<root BTCPP_format="4" main_tree_to_execute="MainTree">

  <BehaviorTree ID="AcquireObject">
    <RetryUntilSuccessful num_attempts="-1">
      <Sequence name="AcquireSequence">
        
        <DetectObject output_pose="{target_pose}" output_id="{target_id}" object_size="{object_size}"/>
        
        <Fallback name="EnsureProximity">
             <IsReachable target="{target_pose}" 
                      robot_base_z="0.11" 
                      max_reach_3d="0.9"  
                      adjustment_pose="{nav_target}"/>
             
             <ParallelAny> 
                <NavigateTo/> 
                <ComputePath planner="a_star" target="{nav_target}"/>
             </ParallelAny>
        </Fallback>
          
        <PickObject pose="{target_pose}" id="{target_id}"/>
      </Sequence>
    </RetryUntilSuccessful>
  </BehaviorTree>

  <BehaviorTree ID="PlaceRoutine">
    <Fallback name="PlaceOrCleanup">
        
        <Sequence name="ApproachAndPlace">
            
            <Fallback name="EnsureProximityStorage">
                <IsReachable target="{storage_pose}" 
                          robot_base_z="0.11" 
                          max_reach_3d="0.9"  
                          adjustment_pose="{storage_pose}"/>
                
                <ParallelAny name="Nav_Replan_Monitor">
                    <NavigateTo/> 
                    <ComputePath planner="a_star" target="{storage_pose}"/>
                    
                    <KeepRunningUntilFailure>
                        <IsGripperHoldingObject/>
                    </KeepRunningUntilFailure>
                </ParallelAny>
            </Fallback>

            <Sequence name="OrganizeSequence">
                <ComputePoseToOrganize storage_pose="{storage_pose}" 
                                    storage_size="{storage_size}"
                                    object_size="{object_size}"
                                    indexes="{indexes}"
                                    object_padding="0.035"
                                    z_lift_offset="0.025"
                                    new_indexes="{indexes}"
                                    output_final_pose="{final_placement_pose}"/> 

                <PlaceObject pose="{final_placement_pose}"/>

                <IncrementOrganizedStorageIndexes storage_id="{storage_id}" new_indexes="{indexes}"/>
            </Sequence>
            
            <ClearTarget/> 
        </Sequence>

        <Sequence name="FailureRecovery">
            <DecrementStorageCount storage_id="{storage_id}"/>
            
            <AlwaysFailure/> </Sequence>

    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="MainTree">
    <RetryUntilSuccessful num_attempts="-1">
      <Sequence name="FullMission">
        
        <SubTree ID="AcquireObject" 
                 target_id="{target_id}" 
                 target_pose="{target_pose}"
                 object_size="{object_size}"/>
        
        <GetStorageInfo object_id="{target_id}"
                        indexes="{indexes}" 
                        storage_pose="{storage_pose}" 
                        storage_limits="{storage_limits}"
                        storage_size="{storage_size}"
                        storage_id="{storage_id}"/> 

        <SubTree ID="PlaceRoutine" 
                 storage_pose="{storage_pose}" 
                 storage_limits="{storage_limits}"
                 storage_id="{storage_id}"
                 storage_size="{storage_size}"
                 object_size="{object_size}"
                 indexes="{indexes}"/> </Sequence>
    </RetryUntilSuccessful>
  </BehaviorTree>

</root>