<root BTCPP_format="4" main_tree_to_execute="MainTree">

  <BehaviorTree ID="AcquireObject">
    <Sequence name="AcquireSequence">

      <DetectObject output_pose="{target_pose}" output_id="{target_id}"/>

      <Sequence name="ApproachAndPick">
          
          <Fallback name="EnsureProximity">
             <IsRobotNear target="{target_pose}" threshold="1.0"/>
             
             <ParallelAny>
                <ComputePath target="{target_pose}"/>
                <NavigateTo/> 
             </ParallelAny>
          </Fallback>

          <PickObject pose="{target_pose}" id="{target_id}"/>

      </Sequence>

    </Sequence>
  </BehaviorTree>


  <BehaviorTree ID="PlaceRoutine">
    <Sequence name="PlaceSequence">

      <Sequence name="ApproachAndPlace">
          
          <Fallback name="EnsureProximityStorage">
            <IsRobotNear target="{storage_pose}" threshold="0.50"/>
            
            <ParallelAny>
                <ComputePath target="{storage_pose}"/>
                <NavigateTo/> 
            </ParallelAny>
          </Fallback>

          <PlaceObject pose="{storage_pose}" limits="{storage_limits}"/>

      </Sequence>

    </Sequence>
  </BehaviorTree>


  <BehaviorTree ID="MainTree">
    <Fallback name="MissionOrRecovery">
      
      <Sequence name="FullMission">
        
        <SubTree ID="AcquireObject" target_id="{target_id}" target_pose="{target_pose}"/>
        
        <GetStorageInfo object_id="{target_id}" 
                        storage_pose="{storage_pose}" 
                        storage_limits="{storage_limits}"/>

        <SubTree ID="PlaceRoutine" storage_pose="{storage_pose}" storage_limits="{storage_limits}"/>
    
      </Sequence>

    </Fallback>
  </BehaviorTree>

</root>