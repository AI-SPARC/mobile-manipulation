<root BTCPP_format="4">

  <BehaviorTree ID="Place">
    <Fallback name="PlaceOrCleanup">
        
        <Sequence name="ApproachAndPlace">
            <RetryUntilSuccessful num_attempts="3">
                <Fallback name="EnsureProximityStorage">
                    <IsReachable target="{final_placement_pose}"
                            object_id="{storage_id}" 
                            robot_base_z="0.11" 
                            max_reach_3d="0.9" 
                            adjustment_pose="{nav_target}"/>
                    
                    <Sequence name="PlanAndExecuteDelivery">                        
                        <ComputePath planner="a_star" target="{nav_target}"/>
                        
                        <ReactiveSequence name="MonitorMoveAndCargo">
                            <IsStillReachable/>
                            <IsGripperHoldingObject/> 
                            <IsPathClear/> 
                            <FollowPath/> 
                        </ReactiveSequence>
                    </Sequence>
                </Fallback>
             </RetryUntilSuccessful>

            <Sequence name="OrganizeSequence">
                <PlaceObject pose="{final_placement_pose}"/>
            </Sequence>
            
            <ClearTarget/> 
        </Sequence>

        <Sequence name="FailureRecovery">
            <DecrementStorageCount storage_id="{storage_id}"/>
            <AlwaysFailure/>
        </Sequence>

    </Fallback>
  </BehaviorTree>

  <!-- Documentação das portas para Groot -->
  <TreeNodesModel>
    <SubTree ID="Place">
      <input_port name="storage_id" description="ID do local de armazenamento"/>
      <input_port name="final_placement_pose" description="Pose final para colocar objeto (x;y;z)"/>
    </SubTree>
  </TreeNodesModel>

</root>