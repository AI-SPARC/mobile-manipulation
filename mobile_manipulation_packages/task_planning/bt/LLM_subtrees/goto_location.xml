<root BTCPP_format="4">

  <BehaviorTree ID="GoToLocation">
    <Sequence name="PlanAndExecute">
        <ComputePath planner="a_star" target="{nav_target}"/>
        
        <ReactiveSequence name="MonitorAndMove">
            <IsPathClear/>  
            <FollowPath/>   
        </ReactiveSequence>
    </Sequence>
  </BehaviorTree>

  <!-- Documentação das portas para Groot -->
  <TreeNodesModel>
    <SubTree ID="GoToLocation">
      <input_port name="nav_target" description="Pose de destino (x;y;z)"/>
    </SubTree>
  </TreeNodesModel>

</root>